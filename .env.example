# ---------------------------------------------------------------------------
# Mobile (apps/mobile) — only EXPO_PUBLIC_* values are bundled into the app.
# Never put secrets in EXPO_PUBLIC_* variables.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
# Optional cloud sync API. Leave empty to build a fully local app.
EXPO_PUBLIC_API_URL=
# Set to 1 only for internal research builds (enables labelled motion capture screens).
EXPO_PUBLIC_RESEARCH_BUILD=0
# Apple Developer Team ID used for signing the iOS app and the watchOS target (not secret).
APPLE_TEAM_ID=

# ---------------------------------------------------------------------------
# Backend (backend/) — loaded by pydantic-settings with the THRESHOLD_ prefix.
# ---------------------------------------------------------------------------
THRESHOLD_ENV=development
THRESHOLD_DATABASE_URL=postgresql+psycopg://threshold:threshold@localhost:5432/threshold
THRESHOLD_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
THRESHOLD_JWT_SECRET=change-me-in-every-environment
# Fernet key for field-level encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THRESHOLD_FIELD_ENCRYPTION_KEY=
THRESHOLD_CORS_ORIGINS=
THRESHOLD_ACCESS_TOKEN_TTL_SECONDS=900
THRESHOLD_REFRESH_TOKEN_TTL_SECONDS=2592000
THRESHOLD_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Intelligence (intelligence/)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./intelligence/mlruns
